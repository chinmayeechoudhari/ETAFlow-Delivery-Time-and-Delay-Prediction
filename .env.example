# ==============================================================================
# ETAFlow Environment Configuration Template
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
RELOAD=true

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=etaflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etaflow

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=etaflow-delivery-prediction

# DVC Remote Storage (Optional: S3 / GCS / Azure / Local)
# DVC_REMOTE_URL=s3://my-etaflow-bucket/dvcstore

# Monitoring & Metrics
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
EVIDENTLY_REPORT_DIR=reports/monitoring
